{
  "name": "pdf_read",
  "description": "Read a PDF file and return its text page by page. Plain-text PDFs only: scanned pages, encrypted files and exotic fonts are not supported.",
  "kind": "code",
  "ui": {"mode": "form", "fields": {"path": {"label": "PDF file", "filter": "*.pdf"}}},
  "input_schema": {"type": "object", "required": ["path"], "properties": {
    "path": {"type": "string", "description": "PDF file in the working folder"},
    "first_page": {"type": "integer", "description": "first page to read, from 1 (default 1)"},
    "last_page": {"type": "integer", "description": "last page to read (default: the last)"}}},
  "output_schema": {"type": "object", "properties": {
    "pages": {"type": "array", "description": "[{page, text}]"},
    "page_count": {"type": "integer"},
    "empty_pages": {"type": "array", "description": "pages with no extractable text (scans, images)"},
    "text": {"type": "string", "description": "all page texts joined"}}},
  "permissions": {"network": [], "packages": {}},
  "edge_cases": ["not a PDF", "encrypted file", "page without text", "page range past the end"],
  "created_by": {"provider": "bundled", "model": "none"},
  "test_file": "test_tool.py"
}
