#!/usr/bin/env python3
"""Print the GGUF file of an Ollama model, so llama-server can load it without a second copy on disk.

usage: scripts/ollama-gguf MODEL[:TAG] [--part model|projector|draft]
       scripts/ollama-gguf --list
The models directory comes from $OLLAMA_MODELS, else the ollama service's setting, else ~/.ollama/models.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from mini.harness.ollama_store import gguf, list_models  # noqa: E402


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 2
    if argv[0] == "--list":
        for name, size in list_models():
            print(f"{name}\t{size / 1e9:.1f} GB")
        return 0
    try:
        print(gguf(argv[0], argv[argv.index("--part") + 1] if "--part" in argv else "model"))
    except (OSError, ValueError, KeyError) as e:
        print(e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
